configuration {
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun: "apps ";
    font: "JetBrainsMono Nerd Font 11";
}

* {
    background-color: transparent;
    text-color: #d0ddd3;

    bg: #0b120d;
    bg-alt: #142418;
    bg-search: #1d3024;
    bg-selected: #1d3024;

    border-dark: #294a31;
    border: #35633f;

    accent: #76a882;
    accent-bright: #9aff9a;

    text-muted: #91a596;
}

/* main window */

window {
    width: 500px;

    border: 1px;
    border-color: @border-dark;
    border-radius: 0;

    background-color: @bg;

    padding: 12px;
}

/* layout */

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
    background-color: @bg;
}

/* search bar */

inputbar {
    children: [ prompt, entry ];

    background-color: @bg-search;

    border: 1px;
    border-color: @border;

    border-radius: 0;

    padding: 8px 10px;
}

prompt {
    text-color: @accent;
    background-color: transparent;
}

entry {
    text-color: #d0ddd3;
    background-color: transparent;

    placeholder: "search...";
    placeholder-color: @text-muted;
}

/* application list */

listview {
    lines: 8;
    columns: 1;

    scrollbar: false;

    spacing: 2px;

    background-color: @bg;

    border: 1px;
    border-color: @border-dark;

    border-radius: 0;

    padding: 0px;
}

/* rows */

element {
    padding: 7px 8px;
    spacing: 10px;

    border-radius: 0;

    background-color: @bg;
    text-color: @text-muted;
}

/* normal */

element normal.normal {
    background-color: @bg;
    text-color: @text-muted;
}

/* alternate */

element alternate.normal {
    background-color: @bg;
    text-color: @text-muted;
}

/* selected */

element selected.normal {
    background-color: @bg-selected;
    text-color: #e8f5ea;

    border: 1px;
    border-color: @accent;
}

/* urgent */

element normal.urgent {
    background-color: @bg;
    text-color: @accent-bright;
}

element alternate.urgent {
    background-color: @bg;
    text-color: @accent-bright;
}

element selected.urgent {
    background-color: @bg-selected;
    text-color: #ffffff;

    border: 1px;
    border-color: @accent-bright;
}

/* active */

element normal.active {
    background-color: @bg;
    text-color: @text-muted;
}

element alternate.active {
    background-color: @bg;
    text-color: @text-muted;
}

element selected.active {
    background-color: @bg-selected;
    text-color: #e8f5ea;

    border: 1px;
    border-color: @accent;
}

/* icons */

element-icon {
    size: 24px;
    background-color: transparent;
}

/* text */

element-text {
    text-color: @text-muted;
    background-color: transparent;
    vertical-align: 0.5;
}

/* selected text */

element-text selected {
    text-color: #e8f5ea;
    background-color: transparent;
}
