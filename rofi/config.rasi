configuration {
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun: "apps ";
    font: "JetBrainsMono Nerd Font 11";
}

* {
    background-color: transparent;
    text-color: #d0d5d1;

    bg: #171a18;
    bg-alt: #202521;
    bg-search: #252b26;
    bg-selected: #343d35;

    border-dark: #303732;
    border: #414941;

    accent: #91a596;
    accent-bright: #b5c9b6;

    text-muted: #939b95;
}

/* main window */

window {
    width: 500px;

    border: 1px;
    border-color: @border-dark;
    border-radius: 6px;

    background-color: @bg;

    padding: 12px;
}

/* layout */

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
    background-color: @bg;
}

/* search bar */

inputbar {
    children: [ prompt, entry ];

    background-color: @bg-search;

    border: 0px;
    border-radius: 6px;

    padding: 10px 12px;
}

prompt {
    text-color: @accent;
    background-color: transparent;
}

entry {
    text-color: #d0d5d1;
    background-color: transparent;

    placeholder: "search...";
    placeholder-color: @text-muted;
}

/* application list */

listview {
    lines: 8;
    columns: 1;

    scrollbar: false;

    spacing: 4px;

    background-color: @bg;

    border: 0px;
    border-radius: 6px;

    padding: 0px;
}

/* rows */

element {
    padding: 8px 10px;
    spacing: 10px;

    border: 0px;
    border-radius: 6px;

    background-color: @bg;
    text-color: @text-muted;
}

/* normal */

element normal.normal {
    background-color: @bg;
    text-color: @text-muted;
}

/* alternate */

element alternate.normal {
    background-color: @bg;
    text-color: @text-muted;
}

/* selected */

element selected.normal {
    background-color: @bg-selected;
    text-color: #e0e6e0;

    border: 0px;
}

/* urgent */

element normal.urgent {
    background-color: @bg;
    text-color: @accent-bright;
}

element alternate.urgent {
    background-color: @bg;
    text-color: @accent-bright;
}

element selected.urgent {
    background-color: #414b42;
    text-color: #e8eee8;

    border: 0px;
}

/* active */

element normal.active {
    background-color: @bg;
    text-color: @text-muted;
}

element alternate.active {
    background-color: @bg;
    text-color: @text-muted;
}

element selected.active {
    background-color: @bg-selected;
    text-color: #e0e6e0;

    border: 0px;
}

/* icons */

element-icon {
    size: 24px;
    background-color: transparent;
}

/* text */

element-text {
    text-color: @text-muted;
    background-color: transparent;
    vertical-align: 0.5;
}

/* selected text */

element-text selected {
    text-color: #e0e6e0;
    background-color: transparent;
}
