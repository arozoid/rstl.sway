/* rstl.sway power menu — rounded 3x2 grid */

configuration {
    show-icons: true;
    font: "JetBrainsMono Nerd Font 14";
}

window {
    width: 540px;

    border: 1px;
    border-color: #303732;
    border-radius: 16px;

    background-color: rgba(23, 26, 24, 0.96);

    padding: 12px;
}

mainbox {
    children: [ listview ];
    spacing: 0;
    background-color: transparent;
}

listview {
    columns: 3;
    lines: 2;
    fixed-columns: true;
    flow: horizontal;

    spacing: 8px;
    padding: 0px;

    scrollbar: false;
    background-color: transparent;

    border: 0px;
}

element {
    children: [ element-icon, element-text ];
    orientation: vertical;

    spacing: 14px;
    padding: 20px 10px 16px;

    border: 0px;
    border-radius: 12px;

    background-color: rgba(32, 37, 33, 0.85);
}

element normal.normal {
    background-color: rgba(32, 37, 33, 0.85);
}

element selected.normal {
    background-color: #343d35;
}

element-icon {
    size: 42px;

    horizontal-align: 0.5;
    vertical-align: 0.5;

    background-color: transparent;
}

element-text {
    horizontal-align: 0.5;

    text-color: #c4ccc5;
    background-color: transparent;
}

element selected.normal element-text {
    text-color: #e0e6e0;
}
