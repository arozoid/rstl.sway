# sway config for rstl.sway
#
# This file holds the modifier and window rules. Keybindings and default apps
# live in config.d so rstl-tune can update them.
#
# The config.d files are included at the bottom in name order:
#
#   05-default-apps  terminal and application launcher
#   10-appearance    window borders and colors
#   20-cursor        cursor theme
#   25-displays      output configuration
#   30-input         pointer defaults
#   40-autostart     startup applications
#   50-keybindings   Sway shortcuts
#
# rstl-tune stores per-user overrides in local/, which installers preserve.

### modifier
set $mod Mod4 

### window rules
for_window [app_id="termfilechooser"] floating enable, resize set width 1000 px height 600 px, move position center
for_window [app_id="rstlpk"] floating enable, resize set width 650 px height 250 px, move position center

for_window [app_id="calpopup"] floating enable
for_window [app_id="calpopup"] resize set width 250 px height 250 px
for_window [app_id="calpopup"] move position center
for_window [app_id="calpopup"] border pixel 1 

for_window [app_id="rstl-pick"] floating enable
for_window [app_id="rstl-pick"] border pixel 0 
for_window [app_id="rstl-pick"] move position center
for_window [app_id="rstl-pick"] resize set width 750 px height 550 px

for_window [app_id="rstl-tune"] floating enable
for_window [app_id="rstl-tune"] border pixel 1
for_window [app_id="rstl-tune"] move position center
for_window [app_id="rstl-tune"] resize set width 950 px height 700 px

# ---------------------------------------------------------------------------
# settings: included in name order, so a higher number wins over a lower one
# ---------------------------------------------------------------------------
include ~/.config/rstl.sway/sway/config.d/*.conf

# settings written by rstl-tune. Kept outside config.d so
# the installers do not purge them; they intentionally come last.
include ~/.config/rstl.sway/local/*.conf
