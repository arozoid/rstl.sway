#!/bin/sh
# rstl - deprecated compatibility command; use rstl-tune.
#
# Usage:
#   rstl-tune                 open settings
#   rstl-tune update          update this installation
#   rstl <script> [arguments] run a legacy bin/ script

set -u
RSTL_SWAY_DIR="${RSTL_SWAY_DIR:-${HOME}/.config/rstl.sway}"
BIN_DIR="$RSTL_SWAY_DIR/bin"
RATL_DIR="$RSTL_SWAY_DIR/ratl"

if [ "$#" -eq 0 ]; then
    printf '%s\n' 'rstl is deprecated; opening rstl-tune.' >&2
    [ ! -x "$BIN_DIR/rstl-tune" ] || exec "$BIN_DIR/rstl-tune"
    exec rstl-tune
fi

case "$1" in
    -h|--help)
        printf '%s\n' 'rstl is deprecated. Use rstl-tune for settings and updates.' >&2
        sed -n '2,$ { /^#/!q; s/^#[[:space:]]\{0,1\}//p; }' "$0"
        exit 0
        ;;
    update|update.sh)
        shift
        printf '%s\n' 'rstl update is deprecated; use rstl-tune update.' >&2
        [ ! -x "$BIN_DIR/rstl-tune" ] || exec "$BIN_DIR/rstl-tune" update "$@"
        exec rstl-tune update "$@"
        ;;
esac

printf '%s\n' 'rstl is deprecated; use rstl-tune for settings and updates.' >&2
script="$1"
shift
case "$script" in
    */*) path="$script" ;;
    *)
        path=""
        for directory in "$BIN_DIR" "$RATL_DIR"; do
            if [ -f "$directory/$script" ]; then path="$directory/$script"; break; fi
            if [ -f "$directory/$script.sh" ]; then path="$directory/$script.sh"; break; fi
        done
        [ -n "$path" ] || path="$BIN_DIR/$script"
        ;;
esac
[ -f "$path" ] || { printf 'rstl: no script named %s\n' "$script" >&2; exit 1; }
[ "${path##*/}" != rstl ] || { printf '%s\n' 'rstl: refusing recursive invocation' >&2; exit 2; }
if [ -x "$path" ]; then exec "$path" "$@"; fi
exec sh "$path" "$@"
