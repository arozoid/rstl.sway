# rstl-first-login ran marker
.first-login-done

# edition indicator: written by the installers on every run, read by
# bin/update.sh. It describes the machine, not the repository.
.rstl-edition

# settings written by ratl/rstl-settings and its sub-tools. The directory
# and its README are tracked; generated state is not.
local/*
!local/README.md

# micro runtime state (auto-generated through the ~/.config/micro symlink);
# settings.json + colorschemes/ + syntax/ are the vendored package content
micro/bindings.json
micro/buffers/
