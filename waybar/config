// ~/.config/waybar/config

{
    "layer": "top",
    "position": "top",

    "modules-left": [
        "backlight",
        "custom/spacer",
        "sway/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/cpu",
        "memory",
        //"network",
        "pulseaudio",
        "battery"
    ],

    
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left", 
            "iso8601": true,
            "format": {
                "months": "<span color='#a3b18a'><b>{}</b></span>",
                "days": "<span color='#e9ecef'><b>{}</b></span>",
                "weeks": "<span color='#588157'><b>{}</b></span>",
                "weekdays": "<span color='#ddb892'><b>{}</b></span>",
                "today": "<span color='#a3b18a'><b><u>{}</u></b></span>"
            }
        }
    },

    "custom/cpu": {
        "exec": "~/.config/waybar/scripts/cpu-tooltip.sh",
        "return-type": "json",
        "format": "{}",
        "tooltip": true
    },

    "memory": {
        "format": "ram {}%"
    },

    "network": {
        "format-wifi": "↓ {bandwidthDownBytes} ↑ {bandwidthUpBytes}",
        "format-ethernet": "↓ {bandwidthDownBytes} ↑ {bandwidthUpBytes}",
        "format-disconnected": "offline"
    },

    "pulseaudio": {
        "format": "vol {volume}%"
    },

    "battery": {
        "format": "bat {capacity}%"
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{percent}%",
        "format-icons": ["li"],
        "on-scroll-up": "brightnessctl set +1%",
        "on-scroll-down": "brightnessctl set 1%-"
    },

    "custom/spacer": {
        "format": " ", // Add as many spaces as you need
        "tooltip": false
    }
}
