# rstl — lf config

set hidden
set mouse
set preview
set icons
set incsearch
set dirfirst

# foresty green borders
set drawbox
set borderstyle separators 
set borderfmt "\033[38;5;65m"

# cursor styling (muted green highlight)
set cursoractivefmt "\033[38;5;108m\033[48;5;65m"

# use the foresty green colors
source ~/.config/lf/colors

# open highlighted file/folder on enter
map <enter> open
map <return> open

# keybindings
map q quit
map . set hidden!
map gh cd ~
map gd cd ~/Documents
map gl cd ~/Pictures
map gD cd ~/Downloads
map gs cd ~/.config/rstl.sway

# preview
set previewer scope.sh
set cleaner cleanup.sh
