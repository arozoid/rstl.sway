bar:
  location: top
  height: 35 
  layer: overlay
  margin: 0
  spacing: 0
  left-spacing: 0
  right-spacing: 0

  font: JetBrainsMono Nerd Font:pixelsize=23
  foreground: ddddddff
  background: 111111ff

  left:
    - label:
        content: {string: {text: " "}}
          
    - backlight:
        name: intel_backlight
        content:
          map:
            conditions:
              percent < 36:
                - string: {text: "󰃞 {percent}%", foreground: ccccccff}
              percent < 66:
                - string: {text: "󰃟 {percent}%", foreground: ccccccff}
              percent > 66:
                - string: {text: "󰃠 {percent}%", foreground: ccccccff}

    - label:
        content: {string: {text: "   "}}

    - i3:
        sort: native
        strip-workspace-numbers: true
        left-spacing: 24 
        right-spacing: 24
        content:
          "":
            map:
              default:
                string: {text: "{name}", foreground: 666666ff}
              conditions:
                focused:
                  string: {text: "{name}", foreground: ffffffff}

  center:
    - clock:
        time-format: "%H:%M"
        content:
          string:
            text: "{time}"
            foreground: ccccccff
  
  right:
    - cpu:
        poll-interval: 2500
        content:
          map:
            conditions:
              id < 0:
                - string: {text: "", foreground: ccccccff}
                - string: {text: " {cpu}%", foreground: ccccccff}

    - label:
        content: {string: {text: "   "}}

    - mem:
        poll-interval: 2500
        content:
          string: {text: " {percent_used}%", foreground: ccccccff}

    - label:
        content: {string: {text: "   "}}

    - pulse:
        content:
          map:
            conditions:
              sink_muted:
                - string: {text: "󰝟 {sink_percent}%", foreground: 666666ff}
              sink_percent >= 66:
                - string: {text: "󰕾 {sink_percent}%", foreground: ccccccff}
              sink_percent >= 33:
                - string: {text: "󰖀 {sink_percent}%", foreground: ccccccff}
              sink_percent == 0:
                - string: {text: "󰖁 {sink_percent}%", foreground: ccccccff}
              default:
                - string: {text: "󰕿 {sink_percent}%", foreground: ccccccff}

    - battery:
        name: BAT0
        poll-interval: 250
        content:
          map:
            conditions:
              capacity == 0:
                - string: {text: "", foreground: ccccccff}
              capacity < 11:
                - string: {text: "    {capacity}%", foreground: ccccccff}
              capacity < 31:
                - string: {text: "    {capacity}%", foreground: ccccccff}
              capacity < 61:
                - string: {text: "    {capacity}%", foreground: ccccccff}
              capacity < 81:
                - string: {text: "    {capacity}%", foreground: ccccccff}
              capacity >= 81:
                - string: {text: "    {capacity}%", foreground: ccccccff}
              default:
                - string: {text: "    {capacity}%", foreground: ccccccff}

    - label:
        content: {string: {text: " "}}

