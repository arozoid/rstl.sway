# rstl.sway idle/lock daemon
# lock after 3 minutes idle, dpms-off after 10 minutes
#
# NOTE: the swayidle build here only accepts timeout/lock/unlock/before-sleep
# (resume/after-wake are rejected as unknown keywords), so the dpms-off restores
# on unlock. sh -c wraps the lock script so the tilde expands regardless of how
# swayidle exec's the command.

timeout 180 sh -c '~/.config/rstl.sway/scripts/lock.sh'
timeout 600 'swaymsg "output * dpms off"'
lock sh -c '~/.config/rstl.sway/scripts/lock.sh'
unlock 'swaymsg "output * dpms on"'
before-sleep sh -c '~/.config/rstl.sway/scripts/lock.sh'
